---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page introuvable">
  <section class="block">
    <div class="shell" style="text-align: center; padding-block: var(--block);">
      <p class="eyebrow">Erreur 404</p>
      <h2 style="font-size: var(--step-3); margin-bottom: 1rem;">Cette page n’existe pas</h2>
      <p class="prose" style="margin-inline: auto;">Le lien est peut-être périmé, ou la page a changé d’adresse.</p>
      <p style="margin-top: 2rem;"><a class="btn" href="/">Retour à l’accueil</a></p>
    </div>
  </section>
</BaseLayout>
