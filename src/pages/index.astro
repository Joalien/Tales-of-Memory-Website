---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShowList from '../components/ShowList.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import Lightbox from '../components/Lightbox.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site, activeLinks } from '../data/site';
import { upcoming, nextShow } from '../lib/shows';
import { concertGalleries, latestPhotos, pressPhotos, src, srcset } from '../lib/photos';
import { longDate, time } from '../lib/format';
import { cover as albumCover, coverSrc, coverSrcset } from '../lib/album';

const nextThree = upcoming.slice(0, 3);
const recent = latestPhotos(6);
const recentGallery = concertGalleries[0];
const release = site.releases[0];

/** Photo de groupe en fond du bandeau : on privilégie un cliché à l'horizontale. */
const press = pressPhotos;
const heroPhoto = press?.photos.find((p) => p.w > p.h) ?? press?.photos[0];
const hero = press && heroPhoto
  ? { src: src(press.slug, heroPhoto.id, 1600), srcset: srcset(press.slug, heroPhoto.id), w: heroPhoto.w, h: heroPhoto.h }
  : null;
---

<BaseLayout>
  <section class="hero">
    {hero && (
      <div class="hero-media" aria-hidden="true">
        <img
          src={hero.src}
          srcset={hero.srcset}
          sizes="100vw"
          width={hero.w}
          height={hero.h}
          alt=""
          fetchpriority="high"
          decoding="async"
        />
      </div>
    )}
    <div class="shell">
      <h1 class="hero-name">{site.name}</h1>
      <p class="hero-tagline">{site.tagline}</p>
      <div class="hero-actions">
        <a class="btn" href="/concerts">Les concerts</a>
        <a class="btn btn-ghost" href="/ecouter">Écouter</a>
        <SocialLinks variant="compact" />
      </div>

      {nextShow && (
        <div class="next-show">
          <span class="label">Prochaine date</span>
          <span class="what">{nextShow.venue}{nextShow.city && ` · ${nextShow.city}`}</span>
          <span class="spacer"></span>
          <span class="when">
            {longDate(nextShow.startsAt)}{!nextShow.allDay && ` · ${time(nextShow.startsAt)}`}
          </span>
          {nextShow.ticketsUrl && (
            <a class="btn" href={nextShow.ticketsUrl} target="_blank" rel="noopener">Billets</a>
          )}
        </div>
      )}
    </div>
  </section>

  <section class="block">
    <div class="shell">
      <div class="section-head">
        <h2>Prochains concerts</h2>
        <a class="more" href="/concerts">Toutes les dates</a>
      </div>
      <ShowList shows={nextThree} empty="Pas de date annoncée pour l’instant. La prochaine tournée s’écrit en répétition." />
    </div>
  </section>

  {release && (
    <section class="block">
      <div class="shell">
        <div class="section-head">
          <h2>Dernière sortie</h2>
          <a class="more" href="/ecouter">Toute la discographie</a>
        </div>
        <div class="release" style="border: 0; padding-top: 0;">
          {albumCover ? (
            <img
              class="release-art"
              src={coverSrc(800)}
              srcset={coverSrcset()}
              sizes="(min-width: 46rem) 18rem, 94vw"
              width={albumCover.w}
              height={albumCover.h}
              loading="lazy"
              decoding="async"
              alt={`Pochette de ${release.title}`}
            />
          ) : (
            <div class="release-cover">{release.title}</div>
          )}
          <div>
            <p class="kind">{release.kind} · {release.year}</p>
            <h3>{release.title}</h3>
            {release.note && <p class="prose" style="margin-top: 0.75rem;">{release.note}</p>}
            {release.links.filter((l) => l.url).length > 0 && (
              <div class="links-row" style="margin-top: 1.5rem;">
                {release.links.filter((l) => l.url).map((l) => (
                  <a href={l.url} target="_blank" rel="noopener">{l.label}</a>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  {recent.length > 0 && recentGallery && (
    <section class="block">
      <div class="shell">
        <div class="section-head">
          <h2>Sur scène</h2>
          <a class="more" href="/photos">Toutes les photos</a>
        </div>
        <PhotoGrid
          gallery={recentGallery.slug}
          photos={recent.filter((p) => p.gallery === recentGallery.slug).map((p) => p.photo)}
          altPrefix={`${site.name} en concert`}
        />
      </div>
    </section>
  )}

  {activeLinks.length > 0 && (
    <section class="block">
      <div class="shell">
        <div class="section-head"><h2>Nous suivre</h2></div>
        <SocialLinks variant="full" />
      </div>
    </section>
  )}

  <Lightbox />
</BaseLayout>
