---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { concertGalleries, src } from '../lib/photos';
import { showBySlug } from '../lib/shows';
import { shortDate } from '../lib/format';

const cards = concertGalleries.map((gallery) => ({
  gallery,
  show: showBySlug(gallery.slug),
}));
---

<BaseLayout title="Photos" description={`Les photos de concert de ${site.name}, salle par salle.`}>
  <section class="block">
    <div class="shell">
      <p class="eyebrow">Galeries</p>
      <div class="section-head"><h2>Photos de concert</h2></div>

      {cards.length === 0 ? (
        <p class="empty">Les premières photos arriveront après le prochain concert.</p>
      ) : (
        <div class="gallery-cards">
          {cards.map(({ gallery, show }) => (
            <a class="gallery-card" href={`/photos/${gallery.slug}`}>
              <img
                src={src(gallery.slug, gallery.cover, 800)}
                width="800"
                height="533"
                loading="lazy"
                decoding="async"
                alt={`${show?.venue ?? gallery.slug} — aperçu de la galerie`}
              />
              <div class="body">
                <p class="venue">{show?.venue ?? gallery.slug}</p>
                <p class="meta">
                  {show?.city && `${show.city} · `}
                  {show ? shortDate(show.startsAt) : ''}
                  {` · ${gallery.photos.length} photo${gallery.photos.length > 1 ? 's' : ''}`}
                </p>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
