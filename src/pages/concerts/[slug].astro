---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import Lightbox from '../../components/Lightbox.astro';
import { site } from '../../data/site';
import { concertGalleries, posterFor, src, srcset } from '../../lib/photos';
import { showBySlug } from '../../lib/shows';
import { longDate } from '../../lib/format';

export function getStaticPaths() {
  return concertGalleries.map((gallery) => ({ params: { slug: gallery.slug }, props: { gallery } }));
}

const { gallery } = Astro.props;
const show = showBySlug(gallery.slug);
const title = show ? `${show.venue}${show.city ? ` · ${show.city}` : ''}` : gallery.slug;
const altPrefix = show ? `${site.name} au ${show.venue}, ${show.city}` : `${site.name} en concert`;
// L'affiche ouvre la page quand le groupe l'a gardée : elle situe la soirée
// avant les photos, qui n'en montrent que des fragments.
const poster = posterFor(gallery.slug);
---

<BaseLayout title={title} description={`Photos de ${site.name} — ${title}.`}>
  <section class="block">
    <div class="shell">
      <p class="eyebrow"><a href="/concerts" style="text-decoration: none;">← Tous les concerts</a></p>
      <div class="section-head">
        <h2>{title}</h2>
        {show && <span class="more" style="text-transform: none; letter-spacing: 0.08em;">{longDate(show.startsAt)}</span>}
      </div>

      {poster && (
        <figure class="concert-poster">
          <img
            src={src(poster.gallery, poster.photo.id, 800)}
            srcset={srcset(poster.gallery, poster.photo.id)}
            sizes="(min-width: 46rem) 22rem, 80vw"
            width={poster.photo.w}
            height={poster.photo.h}
            decoding="async"
            alt={`Affiche du concert — ${title}`}
          />
        </figure>
      )}

      <PhotoGrid gallery={gallery.slug} photos={gallery.photos} altPrefix={altPrefix} />

      <p style="margin-top: 2rem; color: var(--bone-faint); font-size: var(--step--1);">
        {gallery.photos.length} photo{gallery.photos.length > 1 ? 's' : ''}. Cliquez pour agrandir, flèches du clavier pour défiler.
      </p>
    </div>
  </section>

  <Lightbox />
</BaseLayout>
