---
import BaseLayout from '../layouts/BaseLayout.astro';
import AlbumChain from '../components/AlbumChain.astro';
import { site, activeLinks } from '../data/site';
import {
  cover, coverSrc, coverSrcset,
  tracks, trackSrc, trackLabel,
  booklet, bookletHref,
  fullAlbum, fullAlbumHref,
  humanSize,
} from '../lib/album';

/** Les fichiers déposés dans album/ illustrent la sortie la plus récente. */
const hasAlbumFiles = Boolean(cover || tracks.length || booklet || fullAlbum);
---

<BaseLayout title="Écouter" description={`Les sorties de ${site.name} et où les écouter.`}>
  <section class="block">
    <div class="shell">
      <p class="eyebrow">Discographie</p>
      <div class="section-head"><h2>Écouter</h2></div>

      {site.releases.length === 0 && <p class="empty">Les premières sorties arrivent bientôt.</p>}

      {site.releases.map((release, index) => {
        const withFiles = index === 0 && hasAlbumFiles;

        // Une seule structure pour les deux cas : la numérotation doit être
        // identique que les fichiers audio soient présents ou non, sinon une
        // construction automatique renumérote l'intro en 01.
        let played = 0;
        const rows =
          withFiles && tracks.length
            ? tracks.map((t) => ({ label: trackLabel(t), title: t.title, src: trackSrc(t.file) }))
            : release.tracks.map((t) => {
                if (t.intro) return { label: 'Intro', title: t.title, src: null as string | null };
                played += 1;
                return { label: String(played).padStart(2, '0'), title: t.title, src: null as string | null };
              });
        return (
          <article class="release">
            {withFiles && cover ? (
              <img
                class="release-art"
                src={coverSrc(800)}
                srcset={coverSrcset()}
                sizes="(min-width: 46rem) 18rem, 94vw"
                width={cover.w}
                height={cover.h}
                decoding="async"
                alt={`Pochette de ${release.title}`}
              />
            ) : (
              <div class="release-cover">{release.title}</div>
            )}

            <div>
              <p class="kind">{release.kind} · {release.year}</p>
              <h3>{release.title}</h3>
              {release.note && <p class="prose" style="margin-top: 0.75rem;">{release.note}</p>}

              {rows.length > 0 && (
                <ol class:list={['tracklist', { 'tracklist-audio': withFiles && tracks.length > 0 }]}>
                  {rows.map((row) => (
                    <li>
                      <span class="t-num">{row.label}</span>
                      <span class="t-title">{row.title}</span>
                      {row.src && (
                        <audio controls preload="none" src={row.src} aria-label={`Écouter ${row.title}`}>
                          <a href={row.src}>Écouter {row.title}</a>
                        </audio>
                      )}
                    </li>
                  ))}
                </ol>
              )}

              <div class="links-row">
                {withFiles && fullAlbum && fullAlbumHref && (
                  <a class="btn-gold" href={fullAlbumHref} download>
                    <span class="btn-gold-glyph" aria-hidden="true">↓</span>
                    <span>Télécharger l’album</span>
                    <span class="btn-gold-size">{humanSize(fullAlbum.bytes)}</span>
                  </a>
                )}
                {withFiles && booklet && bookletHref && (
                  <a href={bookletHref} download>Jaquette en PDF · {humanSize(booklet.bytes)}</a>
                )}
                {release.links.filter((l) => l.url).map((l) => (
                  <a href={l.url} target="_blank" rel="noopener">{l.label}</a>
                ))}
              </div>
            </div>
          </article>
        );
      })}

      {activeLinks.length > 0 && (
        <div style="margin-top: var(--block);">
          <div class="section-head"><h2>Toutes les plateformes</h2></div>
          <div class="links-row">
            {activeLinks.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.label}</a>)}
          </div>
        </div>
      )}
    </div>
  </section>
  <AlbumChain />
</BaseLayout>
