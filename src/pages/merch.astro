---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { items, shopOpen, shopUrl, shopPlatform } from '../lib/merch';

/**
 * La vitrine. Le site est statique et n'encaisse rien : l'achat se fait sur la
 * plateforme externe, ou de la main à la main sur un concert.
 *
 * Tant qu'aucune boutique n'est ouverte, la page ne promet pas un bouton qui
 * n'existe pas : elle dit où trouver les articles.
 */
---

<BaseLayout
  title={site.shop.label}
  description={`Les disques et le merchandising de ${site.name}.`}
>
  <section class="block">
    <div class="shell">
      <p class="eyebrow">{shopOpen ? 'Boutique' : 'En vente aux concerts'}</p>
      <div class="section-head"><h2>{site.shop.label}</h2></div>

      <p class="prose">
        {shopOpen ? (
          <>
            Les commandes passent par {shopPlatform}, qui s’occupe du paiement et de
            l’expédition. Tout est aussi en vente au stand les soirs de concert.
          </>
        ) : (
          <>
            Les articles sont en vente au stand les soirs de concert. Pour une
            commande à distance, écrivez-nous à
            {' '}<a href={`mailto:${site.email}`}>{site.email}</a> : on vous dit ce
            qui reste en stock et comment on vous l’envoie.
          </>
        )}
      </p>

      {items.length === 0 && <p class="empty">Les premiers articles arrivent bientôt.</p>}

      <ul class="merch-grid">
        {items.map((item) => (
          <li class="merch-card">
            {item.images.length === 0 && (
              <div class="merch-waiting" aria-hidden="true"><span>Visuel à venir</span></div>
            )}

            {/* Les vues sont toutes dans le HTML et superposées : sans
                JavaScript, la première reste visible et les flèches, inutiles,
                ne s'affichent pas. */}
            {item.images.length > 0 && (
              <div class="merch-views" data-vues={item.images.length}>
                {item.images.map((image, i) => (
                  <img
                    class:list={['merch-art', { 'is-active': i === 0 }]}
                    src={image.src}
                    srcset={image.srcset}
                    sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 94vw"
                    width={image.w}
                    height={image.h}
                    loading="lazy"
                    decoding="async"
                    alt={item.images.length > 1 ? `${item.name} — vue ${i + 1}` : item.name}
                  />
                ))}

                {item.images.length > 1 && (
                  <div class="merch-nav" hidden>
                    <button type="button" class="merch-arrow" data-pas="-1" aria-label={`Vue précédente de ${item.name}`}>‹</button>
                    <span class="merch-count" aria-hidden="true"><b>1</b>/{item.images.length}</span>
                    <button type="button" class="merch-arrow" data-pas="1" aria-label={`Vue suivante de ${item.name}`}>›</button>
                  </div>
                )}
              </div>
            )}

            <div class="merch-body">
              <p class="kind">{item.kind}</p>
              <h3>{item.name}</h3>
              {item.text && <p class="merch-text">{item.text}</p>}

              {item.sizes.length > 0 && (
                <p class="merch-sizes">
                  <span class="merch-sizes-label">Tailles</span>
                  {item.sizes.map((size) => <span class="merch-size">{size}</span>)}
                </p>
              )}

              {/* Le prix et le bouton restent collés en bas de la fiche :
                  d'une carte à l'autre ils se lisent sur la même ligne, même
                  quand les descriptions n'ont pas la même longueur. */}
              <div class="merch-buy">
                {item.price && <p class="merch-price">{item.price}</p>}
                {item.href && (
                  <div class="links-row">
                    <a href={item.href} target="_blank" rel="noopener">Commander</a>
                  </div>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>

      {shopOpen && (
        <div class="links-row" style="margin-top: var(--block);">
          <a href={shopUrl} target="_blank" rel="noopener">Voir toute la boutique sur {shopPlatform}</a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  /**
   * Les vues d'un article, changées à la main.
   *
   * Pas de défilement automatique, contrairement aux photos de concert : on
   * regarde un article à son rythme, et une image qui bouge toute seule
   * empêche de la détailler.
   */
  for (const vues of document.querySelectorAll<HTMLElement>('.merch-views[data-vues]')) {
    const images = Array.from(vues.querySelectorAll<HTMLImageElement>('.merch-art'));
    if (images.length < 2) continue;

    const nav = vues.querySelector<HTMLElement>('.merch-nav');
    const compteur = vues.querySelector('.merch-count b');
    let index = 0;

    // Révélées seulement maintenant : sans ce script, elles ne feraient rien.
    if (nav) nav.hidden = false;

    const montrer = (suivant: number) => {
      images[index].classList.remove('is-active');
      index = (suivant + images.length) % images.length;
      images[index].classList.add('is-active');
      // La première image est la seule à ne pas être différée : les autres ne
      // se chargent qu'une fois demandées.
      images[index].loading = 'eager';
      if (compteur) compteur.textContent = String(index + 1);
    };

    for (const bouton of vues.querySelectorAll<HTMLButtonElement>('.merch-arrow')) {
      bouton.addEventListener('click', () => montrer(index + Number(bouton.dataset.pas)));
    }

    // Les flèches du clavier valent les boutons une fois qu'on est dedans.
    vues.addEventListener('keydown', (event) => {
      const pas = { ArrowLeft: -1, ArrowRight: 1 }[(event as KeyboardEvent).key];
      if (!pas) return;
      event.preventDefault();
      montrer(index + pas);
    });
  }
</script>
