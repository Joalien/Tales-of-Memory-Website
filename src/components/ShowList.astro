---
import type { Show } from '../lib/shows';
import { galleryFor, src, srcset } from '../lib/photos';
import { dayNumber, monthShort, year, longDate, time } from '../lib/format';
import { googleCalendarUrl } from '../lib/calendar';

interface Props {
  shows: Show[];
  past?: boolean;
  empty?: string;
}

const { shows, past = false, empty = 'Aucune date pour le moment.' } = Astro.props;
---

<div class="shows">
  {shows.length === 0 && <p class="empty">{empty}</p>}

  {shows.map((show) => {
    const gallery = past ? galleryFor(show.slug) : undefined;
    return (
      <article class:list={['show', { 'is-past': past }]}>
        <div class="show-date" aria-hidden="true">
          <span class="d">{dayNumber(show.startsAt)}</span>
          <span class="m">{monthShort(show.startsAt)}</span>
          <span class="y">{year(show.startsAt)}</span>
        </div>

        <div class="show-main">
          <h3 class="show-venue">
            {show.venue}
            {show.city && <span class="show-city"> · {show.city}</span>}
          </h3>
          <div class="show-meta">
            <span>
              <span class="sr-only">Date : </span>{longDate(show.startsAt)}
              {!show.allDay && ` · ${time(show.startsAt)}`}
            </span>
            {show.price && <span>{show.price}</span>}
            {show.lineup && <span>avec {show.lineup}</span>}
          </div>
        </div>

        {gallery && gallery.photos.length > 0 && (
          <div class="show-strip">
            {gallery.photos.map((photo, i) => (
              <a href={`/concerts/${show.slug}`} tabindex={i === 0 ? undefined : -1} aria-hidden={i === 0 ? undefined : 'true'}>
                <img
                  src={src(show.slug, photo.id, 400)}
                  srcset={srcset(show.slug, photo.id)}
                  sizes="12rem"
                  width={Math.round((104 * photo.w) / photo.h)}
                  height={104}
                  loading="lazy"
                  decoding="async"
                  alt={i === 0 ? `Photos du concert au ${show.venue}` : ''}
                />
              </a>
            ))}
          </div>
        )}

        {!past && (
        <div class="show-actions">
          {!past && show.ticketsUrl && (
            <a class="btn" href={show.ticketsUrl} target="_blank" rel="noopener">Billetterie</a>
          )}
          {!past && (
            <a
              class="btn btn-ghost"
              href={googleCalendarUrl(show)}
              target="_blank"
              rel="noopener"
              aria-label={`Ajouter ${show.venue} à mon agenda`}
            >Ajouter à mon agenda</a>
          )}
          {!past && show.address && (
            <a
              class="btn btn-ghost"
              href={`https://www.openstreetmap.org/search?query=${encodeURIComponent(show.address)}`}
              target="_blank"
              rel="noopener"
            >Y aller</a>
          )}
        </div>
        )}
      </article>
    );
  })}
</div>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
