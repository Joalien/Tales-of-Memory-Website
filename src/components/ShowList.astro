---
import type { Show } from '../lib/shows';
import { galleryFor, posterFor, src, srcset } from '../lib/photos';
import { dayNumber, monthShort, year, longDate, time } from '../lib/format';
import { googleCalendarUrl } from '../lib/calendar';

interface Props {
  shows: Show[];
  past?: boolean;
  empty?: string;
}

const { shows, past = false, empty = 'Aucune date pour le moment.' } = Astro.props;
---

<div class="shows">
  {shows.length === 0 && <p class="empty">{empty}</p>}

  {shows.map((show) => {
    const gallery = past ? galleryFor(show.slug) : undefined;
    const hasPhotos = Boolean(gallery && gallery.photos.length > 0);
    // Les photos d'abord, l'affiche à défaut : elles occupent la même place et
    // ne s'affichent jamais ensemble. Une date passée sans photos montre donc
    // son affiche plutôt qu'un vide — sans quoi celle d'un concert resté sans
    // photo ne s'afficherait nulle part, faute de page de galerie.
    const poster = hasPhotos ? undefined : posterFor(show.slug);
    const PosterTag = show.ticketsUrl ? 'a' : 'div';
    return (
      <article class:list={['show', { 'is-past': past }]}>
        <div class="show-date" aria-hidden="true">
          <span class="d">{dayNumber(show.startsAt)}</span>
          <span class="m">{monthShort(show.startsAt)}</span>
          <span class="y">{year(show.startsAt)}</span>
        </div>

        <div class="show-main">
          <h3 class="show-venue">
            {show.venue}
            {show.city && <span class="show-city"> · {show.city}</span>}
          </h3>
          <div class="show-meta">
            <span>
              <span class="sr-only">Date : </span>{longDate(show.startsAt)}
              {!show.allDay && ` · ${time(show.startsAt)}`}
            </span>
            {show.price && <span>{show.price}</span>}
            {show.lineup && <span>avec {show.lineup}</span>}
          </div>
        </div>

        {hasPhotos && gallery && (
          <a
            class="show-carousel"
            href={`/concerts/${show.slug}`}
            data-depart={String(gallery.photos.length > 1)}
            aria-label={`Voir les ${gallery.photos.length} photo${gallery.photos.length > 1 ? 's' : ''} du concert au ${show.venue}`}
          >
            {gallery.photos.map((photo, i) => (
              <img
                class:list={['show-slide', { 'is-active': i === 0 }]}
                src={src(show.slug, photo.id, 800)}
                srcset={srcset(show.slug, photo.id)}
                sizes="(min-width: 52rem) 24rem, 92vw"
                width={photo.w}
                height={photo.h}
                loading="lazy"
                decoding="async"
                alt=""
              />
            ))}
            {gallery.photos.length > 1 && (
              <span class="show-carousel-count"><b>1</b>/{gallery.photos.length}</span>
            )}
          </a>
        )}

        {poster && (
          // Lien vers la billetterie quand il y en a une — c'est le geste
          // attendu de qui s'arrête sur une affiche —, simple image sinon :
          // un lien qui ne mène nulle part se signale au clavier pour rien.
          <PosterTag
            class="show-poster"
            href={show.ticketsUrl || undefined}
            target={show.ticketsUrl ? '_blank' : undefined}
            rel={show.ticketsUrl ? 'noopener' : undefined}
            aria-label={show.ticketsUrl ? `Billetterie — ${show.venue}` : undefined}
          >
            <img
              src={src(poster.gallery, poster.photo.id, 800)}
              srcset={srcset(poster.gallery, poster.photo.id)}
              sizes="(min-width: 52rem) 24rem, 92vw"
              width={poster.photo.w}
              height={poster.photo.h}
              loading="lazy"
              decoding="async"
              alt={`Affiche du concert au ${show.venue}`}
            />
          </PosterTag>
        )}

        {!past && (
        <div class="show-actions">
          {!past && show.ticketsUrl && (
            <a class="btn" href={show.ticketsUrl} target="_blank" rel="noopener">Billetterie</a>
          )}
          {!past && (
            <a
              class="btn btn-ghost"
              href={googleCalendarUrl(show)}
              target="_blank"
              rel="noopener"
              aria-label={`Ajouter ${show.venue} à mon agenda`}
            >Ajouter à mon agenda</a>
          )}
          {!past && show.address && (
            <a
              class="btn btn-ghost"
              href={`https://www.openstreetmap.org/search?query=${encodeURIComponent(show.address)}`}
              target="_blank"
              rel="noopener"
            >Y aller</a>
          )}
        </div>
        )}
      </article>
    );
  })}
</div>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  const carrousels = Array.from(document.querySelectorAll<HTMLElement>('.show-carousel[data-depart="true"]'));
  const calme = window.matchMedia('(prefers-reduced-motion: reduce)');

  carrousels.forEach((carrousel, rang) => {
    const vues = Array.from(carrousel.querySelectorAll<HTMLImageElement>('.show-slide'));
    const compteur = carrousel.querySelector('.show-carousel-count b');
    let index = 0;
    let minuteur: number | undefined;
    let demarrage: number | undefined;

    const avancer = () => {
      vues[index].classList.remove('is-active');
      index = (index + 1) % vues.length;
      vues[index].classList.add('is-active');
      if (compteur) compteur.textContent = String(index + 1);
    };

    const arreter = () => {
      if (minuteur) { clearInterval(minuteur); minuteur = undefined; }
      if (demarrage) { clearTimeout(demarrage); demarrage = undefined; }
    };

    const lancer = () => {
      arreter();
      if (calme.matches) return;
      // Décalage selon le rang : sans lui, toutes les dates basculeraient à la
      // même seconde et la page clignoterait d'un bloc.
      demarrage = window.setTimeout(() => {
        avancer();
        minuteur = window.setInterval(avancer, 5200);
      }, 1300 * (rang % 4));
    };

    // Seuls les carrousels réellement à l'écran tournent.
    new IntersectionObserver(
      ([e]) => (e.isIntersecting && !document.hidden ? lancer() : arreter()),
      { threshold: 0.3 },
    ).observe(carrousel);

    carrousel.addEventListener('mouseenter', arreter);
    carrousel.addEventListener('mouseleave', lancer);
    document.addEventListener('visibilitychange', () => { if (document.hidden) arreter(); });
    calme.addEventListener('change', lancer);
  });
</script>
