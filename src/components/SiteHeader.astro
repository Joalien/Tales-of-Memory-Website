---
import { site, nav } from '../data/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="shell">
    <a class="brand" href="/">{site.name}</a>
    <nav class="nav" aria-label="Navigation principale">
      {/* La boutique est un onglet de `nav` comme les autres, et non un lien
          sortant : le visiteur voit d'abord les articles sur le site, et ne
          quitte celui-ci qu'au moment de commander. */}
      {nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>
