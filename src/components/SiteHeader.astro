---
import { site, nav } from '../data/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="shell">
    {/* L'emblème accompagne le nom sans le remplacer : à la taille du
        bandeau, le nom stylisé ne se lirait plus, alors que l'emblème reste
        reconnaissable. Le nom demeure donc du texte. */}
    <a class="brand" href="/">
      <img class="brand-mark" src="/identite/embleme-bandeau.webp" width="89" height="96" alt="" />
      <span>{site.name}</span>
    </a>
    <nav class="nav" aria-label="Navigation principale">
      {/* La boutique est un onglet de `nav` comme les autres, et non un lien
          sortant : le visiteur voit d'abord les articles sur le site, et ne
          quitte celui-ci qu'au moment de commander. */}
      {nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>
