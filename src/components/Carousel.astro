---
/**
 * Carrousel à défilement automatique.
 *
 * Les clichés de coulisses sont de formats mélangés, portrait et paysage. Une
 * image recadrée en plein cadre amputerait les portraits, donc chaque photo est
 * affichée entière et c'est une version floutée d'elle-même qui remplit le fond.
 */
import { src, srcset, type Photo } from '../lib/photos';

interface Props {
  gallery: string;
  photos: Photo[];
  label: string;
  /** Intervalle entre deux photos, en millisecondes. */
  interval?: number;
}

const { gallery, photos, label, interval = 5000 } = Astro.props;
---

{photos.length > 0 && (
  <div class="carousel" data-interval={interval} aria-roledescription="carrousel" aria-label={label}>
    <div class="carousel-stage">
      {photos.map((photo, i) => (
        <figure class:list={['carousel-slide', { 'is-active': i === 0 }]} aria-hidden={i !== 0 ? 'true' : undefined}>
          <img class="carousel-back" src={src(gallery, photo.id, 400)} alt="" aria-hidden="true" />
          <img
            class="carousel-front"
            src={src(gallery, photo.id, 800)}
            srcset={srcset(gallery, photo.id)}
            sizes="(min-width: 64rem) 60rem, 94vw"
            width={photo.w}
            height={photo.h}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            alt={`${label} — photo ${i + 1} sur ${photos.length}`}
          />
        </figure>
      ))}
    </div>

    {photos.length > 1 && (
      <div class="carousel-dots" role="tablist" aria-label="Choisir une photo">
        {photos.map((_, i) => (
          <button type="button" role="tab" data-go={i} aria-selected={i === 0 ? 'true' : 'false'} aria-label={`Photo ${i + 1}`}></button>
        ))}
      </div>
    )}
  </div>
)}

<script>
  for (const carousel of document.querySelectorAll<HTMLElement>('.carousel')) {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.carousel-slide'));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-go]'));
    if (slides.length < 2) continue;

    const calme = window.matchMedia('(prefers-reduced-motion: reduce)');
    const delai = Number(carousel.dataset.interval ?? 5000);
    let index = 0;
    let minuteur: number | undefined;

    const afficher = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === index);
        // Les photos masquées sortent de l'arbre d'accessibilité, sinon un
        // lecteur d'écran annoncerait les cinq légendes à la suite.
        if (i === index) slide.removeAttribute('aria-hidden');
        else slide.setAttribute('aria-hidden', 'true');
      });
      dots.forEach((dot, i) => dot.setAttribute('aria-selected', i === index ? 'true' : 'false'));
    };

    const arreter = () => { if (minuteur) { clearInterval(minuteur); minuteur = undefined; } };
    const lancer = () => {
      arreter();
      // Pas de défilement imposé à qui a demandé moins d'animations.
      if (calme.matches) return;
      minuteur = window.setInterval(() => afficher(index + 1), delai);
    };

    dots.forEach((dot, i) => dot.addEventListener('click', () => { afficher(i); lancer(); }));

    // On suspend quand l'attention est ailleurs : survol, navigation au
    // clavier dans le carrousel, ou onglet en arrière-plan.
    carousel.addEventListener('mouseenter', arreter);
    carousel.addEventListener('mouseleave', lancer);
    carousel.addEventListener('focusin', arreter);
    carousel.addEventListener('focusout', lancer);
    document.addEventListener('visibilitychange', () => (document.hidden ? arreter() : lancer()));
    calme.addEventListener('change', lancer);

    lancer();
  }
</script>
