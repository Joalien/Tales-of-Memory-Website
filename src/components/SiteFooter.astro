---
import { site, nav, legalNav, activeLinks } from '../data/site';
import SocialLinks from './SocialLinks.astro';
---

<footer class="site-footer">
  <div class="shell">
    <div class="rows">
      <div>
        <p class="brand" style="font-family: var(--font-display); letter-spacing: 0.14em; text-transform: uppercase;">
          {site.name}
        </p>
        <p>{site.tagline}</p>
      </div>

      <div>
        <p style="color: var(--ember); letter-spacing: 0.18em; text-transform: uppercase;">Le site</p>
        <ul>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>

      {activeLinks.length > 0 && (
        <div>
          <p style="color: var(--ember); letter-spacing: 0.18em; text-transform: uppercase;">Nous suivre</p>
          <SocialLinks variant="compact" />
        </div>
      )}

      <div>
        <p style="color: var(--ember); letter-spacing: 0.18em; text-transform: uppercase;">Contact</p>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href="/contact">Booking &amp; presse</a></li>
        </ul>
      </div>
    </div>

    {/* Les pages légales tiennent sur la ligne de copyright, et nulle part
        ailleurs : c'est là qu'un visiteur les cherche, et les mettre dans la
        colonne « Le site » les ferait passer pour du contenu à lire. */}
    <p class="legal">
      © {new Date().getFullYear()} {site.name}
      {legalNav.map((item) => (
        <>{' · '}<a href={item.href}>{item.label}</a></>
      ))}
    </p>
  </div>
</footer>
