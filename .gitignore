node_modules/
dist/
.astro/
.env
.env.local
.DS_Store

# Données reconstruites à chaque build depuis l'agenda et le bucket photos.
src/data/shows.json
src/data/photos.json

# Images de démonstration générées localement.
public/demo/

# Photos originales : elles ne doivent JAMAIS entrer dans Git.
# L'historique Git est éternel et ne se purge pas : quelques centaines de
# fichiers à 8 Mo rendraient le dépôt inutilisable pour toujours.
# Les originaux restent ici en local, seuls les dérivés web partent sur R2.
photos/*
!photos/README.md

# Dérivés web fabriqués en local par `npm run photos`.
#
# Exception assumée : les photos de PRESSE sont versionnées. Elles sont peu
# nombreuses, changent une fois par an, et le bandeau d'accueil comme la page
# bio doivent fonctionner même sans bucket R2.
#
# Les dérivés de CONCERT restent exclus : c'est le volume qui grossit sans
# cesse, et l'historique Git ne se purge pas. Ils passeront par R2.
# fetch-photos.mjs ignore d'office les galeries dont les fichiers sont absents,
# donc un manifeste qui mentionne des concerts non versionnés ne casse rien.
public/media/*
!public/media/manifest.json
!public/media/presse/

# Sources de l'album : pochette pleine résolution, livret, pistes audio.
album/*
!album/README.md

# Dérivés de l'album. Même règle que pour les photos : la pochette est
# versionnée car légère et stable, le livret PDF et les pistes audio non.
public/album/*
!public/album/manifest.json
!public/album/cover/

# Inventaire de l'album, reconstruit à chaque build.
src/data/album.json
